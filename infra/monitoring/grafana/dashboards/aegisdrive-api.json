{
  "title": "AEGISDRIVE API",
  "uid": "aegisdrive-api",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "timezone": "utc",
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "30s",
  "tags": ["aegisdrive", "api"],
  "panels": [
    {
      "id": 1,
      "title": "Request rate by status class",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "sum(rate(aegisdrive_api_http_requests_total[5m])) by (status_code)",
          "legendFormat": "{{status_code}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "5xx error ratio",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "max": 1, "min": 0 }, "overrides": [] },
      "targets": [
        {
          "expr": "sum(rate(aegisdrive_api_http_requests_total{status_code=~\"5..\"}[5m])) / sum(rate(aegisdrive_api_http_requests_total[5m]))",
          "legendFormat": "5xx ratio"
        }
      ]
    },
    {
      "id": 3,
      "title": "p50 / p95 / p99 latency by route",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum(rate(aegisdrive_api_http_request_duration_seconds_bucket[5m])) by (le, route))",
          "legendFormat": "p50 {{route}}"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(aegisdrive_api_http_request_duration_seconds_bucket[5m])) by (le, route))",
          "legendFormat": "p95 {{route}}"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(aegisdrive_api_http_request_duration_seconds_bucket[5m])) by (le, route))",
          "legendFormat": "p99 {{route}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "Dependency health",
      "type": "state-timeline",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "aegisdrive_api_dependency_up",
          "legendFormat": "{{dependency}}"
        }
      ]
    },
    {
      "id": 5,
      "title": "Realtime clients connected (this replica)",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "aegisdrive_api_realtime_connected_clients",
          "legendFormat": "{{instance}}"
        }
      ]
    },
    {
      "id": 6,
      "title": "Rate limit rejections by bucket",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 22 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "sum(rate(aegisdrive_api_rate_limit_rejections_total[5m])) by (bucket)",
          "legendFormat": "{{bucket}}"
        }
      ]
    },
    {
      "id": 7,
      "title": "Event loop lag",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 22 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "expr": "aegisdrive_api_nodejs_eventloop_lag_seconds",
          "legendFormat": "{{instance}}"
        }
      ]
    },
    {
      "id": 8,
      "title": "Process memory (RSS)",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 28 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "targets": [
        {
          "expr": "aegisdrive_api_process_resident_memory_bytes",
          "legendFormat": "{{instance}}"
        }
      ]
    },
    {
      "id": 9,
      "title": "Process CPU usage",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 28 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit" }, "overrides": [] },
      "targets": [
        {
          "expr": "rate(aegisdrive_api_process_cpu_seconds_total[5m])",
          "legendFormat": "{{instance}}"
        }
      ]
    }
  ]
}
