# AEGISDRIVE AI — notifications worker configuration.
#
# Copy to `.env` for local development. Validated at startup by src/config.ts.
# Never commit a populated `.env`.

NODE_ENV=development
LOG_LEVEL=debug

DATABASE_URL=postgresql://aegis:aegis@localhost:5433/aegisdrive?schema=public
REDIS_URL=redis://localhost:6379

POLL_INTERVAL_MS=2000

# Provider credentials. Leave unset in development — every channel logs
# instead of sending; see src/channels.ts.
# SMS_PROVIDER_KEY=
# EMAIL_PROVIDER_KEY=
# PUSH_PROVIDER_KEY=
# VOICE_PROVIDER_KEY=
