# AEGISDRIVE AI — evidence integrity worker configuration.
#
# Copy to `.env` for local development. Validated at startup by src/config.ts.
# Never commit a populated `.env`.

NODE_ENV=development
LOG_LEVEL=debug

DATABASE_URL=postgresql://aegis:aegis@localhost:5433/aegisdrive?schema=public
REDIS_URL=redis://localhost:6379

VERIFY_INTERVAL_MS=21600000
VERIFY_BATCH_SIZE=50
# RETENTION_DAYS defaults to EVIDENCE_RETENTION_DAYS (packages/shared) if unset.

# Object store. Leave unset in development — verification is skipped and the
# worker idles with a warning; see src/index.ts.
# STORAGE_ENDPOINT=
# STORAGE_BUCKET=
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=
