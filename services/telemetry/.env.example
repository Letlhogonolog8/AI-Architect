# AEGISDRIVE AI — telemetry retention worker configuration.
#
# Copy to `.env` for local development. Validated at startup by src/config.ts.
# Never commit a populated `.env`.

NODE_ENV=development
LOG_LEVEL=debug

DATABASE_URL=postgresql://aegis:aegis@localhost:5433/aegisdrive?schema=public
REDIS_URL=redis://localhost:6379

SWEEP_INTERVAL_MS=3600000
SWEEP_BATCH_SIZE=5000
# RETENTION_DAYS defaults to TELEMETRY_HOT_RETENTION_DAYS (packages/shared) if unset.
