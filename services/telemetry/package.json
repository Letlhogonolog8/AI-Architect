{
  "name": "@aegisdrive/telemetry-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Aggregates the telemetry stream and enforces hot-storage retention.",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@aegisdrive/shared": "workspace:*",
    "@aegisdrive/types": "workspace:*",
    "@prisma/client": "catalog:",
    "ioredis": "catalog:",
    "pino": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "esbuild": "0.28.1",
    "tsx": "catalog:"
  }
}
