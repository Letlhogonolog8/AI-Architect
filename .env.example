# Root environment template.
#
# Each app and service also has its own `.env.example` with the full set it
# validates at boot. This file holds only what the convenience scripts at the
# repository root need.
#
# It is NOT read by the Docker Compose stack: Compose resolves its env file
# against the directory holding the compose file, so the stack reads
# `infra/docker/.env`. Copy `infra/docker/.env.example` for that.
#
# Copy to `.env`. Never commit a populated one.

# --------------------------------------------------------------- datastores
POSTGRES_USER=aegis
POSTGRES_PASSWORD=aegis
POSTGRES_DB=aegisdrive

DATABASE_URL=postgresql://aegis:aegis@localhost:5432/aegisdrive?schema=public
REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------------ secrets
# Generate each with: openssl rand -base64 48
# The two MUST differ. The API refuses to start in production if they match.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# -------------------------------------------------------------------- ports
API_PORT=4000
WEB_PORT=5173
AI_PORT=8000
