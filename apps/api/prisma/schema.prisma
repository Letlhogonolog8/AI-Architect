// AEGISDRIVE AI — data model.
//
// Conventions enforced across every model:
//   * UUID primary keys. Sequential integers leak tenant volume and make
//     cross-service references guessable.
//   * Every tenant-owned row carries `organizationId` and indexes it first.
//     Row-level isolation is enforced in the repository layer; the compound
//     indexes here are what make that enforcement free.
//   * `createdAt` / `updatedAt` on every mutable model.
//   * Enum values are byte-identical to packages/types/src/enums.ts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// Enumerations
// ============================================================================

