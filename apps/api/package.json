{
  "name": "@aegisdrive/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AEGISDRIVE AI control-plane API: REST, realtime and RBAC.",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aegisdrive/shared": "workspace:*",
    "@aegisdrive/types": "workspace:*",
    "@prisma/client": "catalog:",
    "@socket.io/redis-adapter": "^8.3.0",
    "bcryptjs": "catalog:",
    "compression": "^1.8.2",
    "cookie-parser": "catalog:",
    "cors": "catalog:",
    "express": "catalog:",
    "helmet": "catalog:",
    "ioredis": "catalog:",
    "jsonwebtoken": "catalog:",
    "pino": "catalog:",
    "pino-http": "catalog:",
    "prom-client": "^15.1.3",
    "socket.io": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "catalog:",
    "@types/cors": "catalog:",
    "@types/express": "catalog:",
    "@types/jsonwebtoken": "catalog:",
    "@types/node": "catalog:",
    "@types/supertest": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "esbuild": "0.28.2",
    "pino-pretty": "^13.2.0",
    "prisma": "catalog:",
    "supertest": "catalog:",
    "tsx": "catalog:",
    "vitest": "catalog:"
  }
}
