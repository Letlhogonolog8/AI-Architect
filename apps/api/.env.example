# AEGISDRIVE AI — API configuration
#
# Copy to `.env` for local development. Every variable is validated at startup
# by src/config/env.ts; the process refuses to boot on an invalid value rather
# than failing later inside a request.
#
# Never commit a populated `.env`.

# ---------------------------------------------------------------- runtime
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=debug

# --------------------------------------------------------------- datastores
DATABASE_URL=postgresql://aegis:aegis@localhost:5433/aegisdrive?schema=public
# Prisma runs migrations and introspection over DIRECT_URL rather than
# DATABASE_URL, because those need session-level state (advisory locks,
# prepared statements) that a transaction-mode pooler cannot carry. With the
# local Docker Postgres above there is no pooler, so both point at it.
DIRECT_URL=postgresql://aegis:aegis@localhost:5433/aegisdrive?schema=public
REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------------ tokens
# Generate with: openssl rand -base64 48
# The two secrets MUST differ — production startup rejects them being equal.
JWT_ACCESS_SECRET=replace-me-with-at-least-32-characters-of-entropy
JWT_REFRESH_SECRET=replace-me-with-a-different-32-plus-character-secret
JWT_ISSUER=aegisdrive.ai
JWT_AUDIENCE=aegisdrive-clients
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# -------------------------------------------------------------------- cors
# Comma-separated. Wildcards are rejected in production.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# ------------------------------------------------------------- rate limits
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=300

# ---------------------------------------------------------------- password
# bcrypt cost. 12 is ~250ms on modern hardware; raise as hardware improves.
BCRYPT_ROUNDS=12

# ------------------------------------------------------- optional services
# AI_SERVICE_URL=http://localhost:8000
# INTERNAL_SERVICE_TOKEN=shared-secret-for-worker-to-api-calls-32-chars-min

# ------------------------------------------------------------------- seed
# Only read by `pnpm db:seed`, and ignored entirely when NODE_ENV=production.
SEED_ADMIN_PASSWORD=ChangeMe-Local-Dev-2026
