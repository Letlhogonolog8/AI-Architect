# AEGISDRIVE mobile.
#
# Expo inlines EXPO_PUBLIC_* into the JS bundle, which ships to every device.
# Anything secret must stay server-side — a key in a mobile binary is public.

EXPO_PUBLIC_API_BASE_URL=http://localhost:4000
EXPO_PUBLIC_REALTIME_URL=http://localhost:4000
EXPO_PUBLIC_ENVIRONMENT=development

# Position reports per minute while a trip is active. Higher resolution costs
# battery and mobile data; 12 (every 5s) is the tuned default for GUARDIAN mode.
EXPO_PUBLIC_TELEMETRY_RATE_PER_MINUTE=12
