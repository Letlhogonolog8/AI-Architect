{
  "name": "@aegisdrive/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "description": "AEGISDRIVE AI driver protection application (Expo).",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "prebuild": "expo prebuild --clean",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "expo lint",
    "doctor": "npx expo-doctor",
    "check:enums": "node scripts/check-enum-drift.mjs",
    "verify": "pnpm run check:enums && pnpm run typecheck"
  },
  "dependencies": {
    "expo": "~53.0.0",
    "expo-application": "~6.1.4",
    "expo-camera": "~16.1.5",
    "expo-constants": "~17.1.4",
    "expo-crypto": "~14.1.4",
    "expo-device": "~7.1.4",
    "expo-file-system": "~18.1.5",
    "expo-haptics": "~14.1.4",
    "expo-linking": "~7.1.4",
    "expo-location": "~18.1.4",
    "expo-network": "~7.1.4",
    "expo-notifications": "~0.31.1",
    "expo-router": "~5.0.5",
    "expo-secure-store": "~14.2.3",
    "expo-sensors": "~14.1.4",
    "expo-splash-screen": "~0.30.6",
    "expo-sqlite": "~15.2.5",
    "expo-status-bar": "~2.2.3",
    "expo-task-manager": "~13.1.4",
    "react": "19.0.0",
    "react-native": "0.79.2",
    "react-native-gesture-handler": "~2.24.0",
    "react-native-reanimated": "~3.17.4",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "~4.10.0",
    "react-native-svg": "15.11.2",
    "@react-native-async-storage/async-storage": "2.1.2",
    "@tanstack/react-query": "^5.90.21",
    "socket.io-client": "^4.8.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/react": "~19.0.10",
    "typescript": "~5.8.3"
  }
}
