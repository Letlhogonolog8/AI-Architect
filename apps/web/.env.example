# AEGISDRIVE web client.
#
# Only `VITE_`-prefixed variables reach the browser bundle. Never put a secret
# here — everything in this file ships to every user in plain text.

# Leave empty to use the dev-server proxy (recommended locally). Set to an
# absolute origin when the client is served from a different host to the API.
VITE_API_BASE_URL=

# Socket.IO endpoint. Empty means "same origin", which the proxy handles.
VITE_REALTIME_URL=

# Mapbox public token. The tactical map is architected but not wired up yet;
# see docs/adr/0004-mapbox-deferred.md.
VITE_MAPBOX_TOKEN=

VITE_APP_ENVIRONMENT=development

# Command-centre backend: `mock` | `live`.
#
#   mock — in-browser simulation: generated fleet, simulated WebSocket, no API
#          needed. Defaults to this in development. REFUSED in production
#          builds; the app throws on boot rather than showing fabricated data.
#   live — calls the REST API and the real Socket.IO server.
#
# See apps/web/src/mocks/README.md.
VITE_DATA_SOURCE=mock
